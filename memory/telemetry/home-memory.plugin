#!/usr/bin/python3
"""Read-only macOS memory collector for Netdata; no service controls.

Output protocol: Netdata external plugins. Private schema-1 JSON is for a
separate fail-closed consumer; process activity never establishes app idleness.
"""
import argparse
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import plistlib
import re
import resource
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time

MIB = 1048576
STATE = Path.home() / '.config/home-server-memory-monitor'
MAX_HISTORY = 32 * MIB
RETENTION_DAYS = 14
PAGE_FIELDS = {
    'free_mib': 'Pages free', 'active_mib': 'Pages active',
    'inactive_mib': 'Pages inactive', 'speculative_mib': 'Pages speculative',
    'wired_mib': 'Pages wired down', 'purgeable_mib': 'Pages purgeable',
    'compressor_mib': 'Pages occupied by compressor',
    'compressed_logical_mib': 'Pages stored in compressor',
    'file_backed_mib': 'File-backed pages', 'anonymous_mib': 'Anonymous pages',
}
RATE_FIELDS = {'swap_in_mib_s': 'Swapins', 'swap_out_mib_s': 'Swapouts',
               'page_in_mib_s': 'Pageins', 'page_out_mib_s': 'Pageouts'}
COUNTERS = set(RATE_FIELDS.values()) | {'Translation faults', 'Compressions', 'Decompressions'}
MONOTONIC_CLOCK = 'CLOCK_MONOTONIC_RAW'


def steady_seconds():
    # macOS Python <3.10 time.monotonic() resets its origin per process.
    # clock_gettime exposes the shared kernel clock needed by one-shot samples.
    return time.clock_gettime(time.CLOCK_MONOTONIC_RAW)


def command(argv, timeout=3):
    # Never collect argv/environ from other processes, or persist command output.
    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout,
                       env={'PATH': '/usr/bin:/bin:/usr/sbin:/sbin', 'LC_ALL': 'C', 'HOME': str(Path.home())})
    if p.returncode or len(p.stdout) > 4 * MIB:
        raise ValueError('command_failed')
    return p.stdout


def parse_host(vm, raw):
    match = re.search(r'page size of (\d+)', vm)
    if not match:
        raise ValueError('page_size_missing')
    size = int(match[1])
    if size not in (4096, 16384):
        raise ValueError('page_size_unknown')
    pages = {k.strip().strip('"'): int(v) for k, v in re.findall(r'^([^:\n]+):\s+(\d+)\.', vm, re.M)}
    values = dict(line.split(': ', 1) for line in raw.splitlines() if ': ' in line)
    host = {key: pages[name] * size / MIB for key, name in PAGE_FIELDS.items()}
    host.update(ram_mib=int(values['hw.memsize']) / MIB,
                pressure_level=int(values['kern.memorystatus_vm_pressure_level']),
                swap_used_mib=float(re.search(r'used = ([\d.]+)M', values['vm.swapusage'])[1]))
    if host['pressure_level'] not in (1, 2, 4):
        raise ValueError('pressure_unknown')
    boot = int(re.search(r'sec\s*=\s*(\d+)', values['kern.boottime'])[1])
    counters = {'page_size': size, 'pages': {k: pages[k] for k in sorted(COUNTERS)}}
    return host, boot, counters


def parse_elapsed(value):
    days, clock = value.split('-', 1) if '-' in value else ('0', value)
    parts = [int(v) for v in clock.split(':')]
    if len(parts) == 2:
        parts.insert(0, 0)
    if len(parts) != 3:
        raise ValueError('elapsed_invalid')
    return int(days) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def parse_mib(value):
    match = re.fullmatch(r'([\d.]+)([BKMGTP])?[+\-]?', value)
    if not match:
        return None
    return float(match[1]) * {None: 1/MIB, 'B': 1/MIB, 'K': 1/1024, 'M': 1,
                             'G': 1024, 'T': 1024**2, 'P': 1024**3}[match[2]]


def parse_codex(ps, top, bundles):
    rows, memory = [], {}
    for line in ps.splitlines():
        v = line.strip().split(None, 4)
        if len(v) == 5 and v[0].isdigit():
            rows.append({'pid': int(v[0]), 'ppid': int(v[1]), 'rss_mib': int(v[2])/1024,
                         'uptime_seconds': parse_elapsed(v[3]), 'path': v[4]})
    for line in top.splitlines():
        v = line.strip().split(None, 3)
        if len(v) == 4 and v[0].isdigit():
            memory[int(v[0])] = parse_mib(v[1])
    direct = [r for r in rows if any(r['path'].startswith(b + '/Contents/') for b in bundles)]
    main = [r for r in direct if any(r['path'] == b + '/Contents/MacOS/' + meta['executable']
                                    for b, meta in bundles.items())]
    errors = []
    matched = sum(memory.get(r['pid']) is not None for r in direct)
    result = {'footprint_mib': None, 'process_count': len(direct), 'matched_process_count': matched,
              'main_pid': None, 'uptime_seconds': None, 'main_path': None,
              'bundle_version': None, 'bundle_build': None}
    if matched == len(direct):
        result['footprint_mib'] = round(sum(memory[r['pid']] for r in direct), 3)
    else:
        errors.append('codex_process_sample_incomplete')
    if len(main) != 1:
        errors.append('codex_main_missing_or_ambiguous')
    else:
        m = main[0]
        meta = next(meta for b, meta in bundles.items() if m['path'].startswith(b + '/Contents/'))
        result.update(main_pid=m['pid'], uptime_seconds=m['uptime_seconds'], main_path=m['path'],
                      bundle_version=meta['version'], bundle_build=meta['build'])
        if not result['bundle_version'] or not result['bundle_build']:
            errors.append('codex_version_missing')
    return result, errors


def add_rates(sample, previous):
    host = sample['host']
    for field in RATE_FIELDS:
        host[field] = None
    host['page_faults_s'] = None
    if previous is None:
        sample['errors'].append('rate_baseline_missing')
        return
    gap = sample['monotonic_seconds'] - previous.get('monotonic_seconds', 0)
    sample['sample_gap_seconds'] = round(gap, 3)
    if (sample.get('monotonic_clock') != MONOTONIC_CLOCK or previous.get('monotonic_clock') != MONOTONIC_CLOCK
            or sample['boot_time'] is None or sample['boot_time'] != previous.get('boot_time')
            or not 30 <= gap <= 150 or sample['source_counters'].get('page_size') != previous.get('source_counters', {}).get('page_size')):
        sample['errors'].append('rate_interval_discontinuous')
        return
    try:
        old = previous['source_counters']['pages']
        new = sample['source_counters']['pages']
        names = list(RATE_FIELDS.values()) + ['Translation faults']
        delta = {name: new[name] - old[name] for name in names}
        if any(value < 0 for value in delta.values()):
            raise ValueError('counter_reset')
        for field, name in RATE_FIELDS.items():
            host[field] = round(delta[name] * sample['source_counters']['page_size'] / MIB / gap, 6)
        host['page_faults_s'] = round(delta['Translation faults'] / gap, 3)
    except (KeyError, TypeError, ValueError):
        sample['errors'].append('rate_counters_missing_or_reset')


def collect(previous=None):
    started = steady_seconds()
    usage = resource.getrusage(resource.RUSAGE_CHILDREN)
    own = time.process_time()
    epoch = time.time()
    sample = {'schema_version': 1, 'sampled_at_epoch': epoch, 'sampled_epoch': epoch,
              'sampled_at': dt.datetime.fromtimestamp(epoch, dt.timezone.utc).isoformat(),
              'monotonic_seconds': started, 'monotonic_clock': MONOTONIC_CLOCK,
              'sample_gap_seconds': None, 'boot_time': None,
              'quality': 'partial', 'errors': [], 'host': {k: None for k in PAGE_FIELDS},
              'codex': {'footprint_mib': None, 'process_count': None, 'matched_process_count': None,
                        'main_pid': None, 'uptime_seconds': None, 'main_path': None,
                        'bundle_version': None, 'bundle_build': None}, 'source_counters': {}}
    sample['host'].update(pressure_level=None, ram_mib=None, swap_used_mib=None)
    try:
        sample['host'], sample['boot_time'], sample['source_counters'] = parse_host(
            command(['/usr/bin/vm_stat']), command(['/usr/sbin/sysctl', 'hw.memsize',
            'kern.memorystatus_vm_pressure_level', 'vm.swapusage', 'kern.boottime']))
    except Exception as exc:
        sample['errors'].append('host_' + type(exc).__name__)
    try:
        bundles = {}
        for name in ('ChatGPT', 'Codex'):
            bundle = Path('/Applications') / (name + '.app')
            plist = bundle / 'Contents/Info.plist'
            if plist.exists():
                d = plistlib.loads(plist.read_bytes())
                if d.get('CFBundleIdentifier') == 'com.openai.codex':
                    bundles[str(bundle)] = {'executable': d['CFBundleExecutable'],
                        'version': d.get('CFBundleShortVersionString'), 'build': d.get('CFBundleVersion')}
        sample['codex'], errors = parse_codex(
            command(['/bin/ps', '-axo', 'pid=,ppid=,rss=,etime=,comm=']),
            command(['/usr/bin/top', '-l', '1', '-stats', 'pid,mem,cmprs,command', '-n', '10000'], 5), bundles)
        sample['errors'].extend(errors)
    except Exception as exc:
        sample['errors'].append('codex_' + type(exc).__name__)
    add_rates(sample, previous)
    after = resource.getrusage(resource.RUSAGE_CHILDREN)
    sample['collector'] = {'duration_seconds': round(steady_seconds() - started, 3),
        'cpu_seconds': round(time.process_time() - own + after.ru_utime + after.ru_stime - usage.ru_utime - usage.ru_stime, 4),
        'max_rss_mib': round(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / MIB, 3)}
    sample['quality'] = 'partial' if sample['errors'] else 'ok'
    return sample


def save(sample, state):
    private_directory(state)
    encoded = json.dumps(sample, separators=(',', ':'), allow_nan=False) + '\n'
    if len(encoded.encode()) > 16384:
        raise ValueError('sample_too_large')
    day = dt.datetime.fromtimestamp(sample['sampled_epoch'], dt.timezone.utc).strftime('%Y%m%d')
    history = state / ('history-' + day + '.jsonl')
    fd = private_open(history, os.O_WRONLY | os.O_CREAT | os.O_APPEND)
    with os.fdopen(fd, 'w') as stream:
        stream.write(encoded)
    # Also enforce the bound under repeated restarts or unexpectedly dense data.
    # Keep complete newest records; normal 60s cadence is far below this limit.
    if history.stat().st_size > MAX_HISTORY // 2:
        with history.open('rb') as stream:
            stream.seek(-MAX_HISTORY // 2, os.SEEK_END)
            tail = stream.read(MAX_HISTORY // 2)
        tail = tail[tail.find(b'\n') + 1:]
        fd, tmp = tempfile.mkstemp(prefix='.history-', dir=str(state))
        try:
            with os.fdopen(fd, 'wb') as stream:
                stream.write(tail)
            os.replace(tmp, history)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    files = sorted(state.glob('history-????????.jsonl'))
    total = sum(p.stat().st_size for p in files)
    for path in files:
        # Only delete our own date-pattern history files; never config/latest/lock.
        if path.is_symlink() or path.stat().st_uid != os.getuid():
            raise ValueError('history_path_untrusted')
        date = dt.datetime.strptime(path.stem[8:], '%Y%m%d').replace(tzinfo=dt.timezone.utc)
        today = dt.datetime.strptime(day, '%Y%m%d').replace(tzinfo=dt.timezone.utc)
        expired = date < today - dt.timedelta(days=RETENTION_DAYS - 1)
        if path != history and (expired or total > MAX_HISTORY):
            total -= path.stat().st_size
            path.unlink()
    # Publish latest only after the history write and retention checks succeed.
    fd, tmp = tempfile.mkstemp(prefix='.latest-', dir=str(state))
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(encoded)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, state / 'latest.json')
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def private_directory(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError('state_directory_untrusted')


def private_open(path, flags):
    fd = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
        os.close(fd)
        raise ValueError('state_file_untrusted')
    return fd


def acquire_lock(lock):
    # On a daemon restart the old plugin may notice its closed output pipe only
    # at the next 60s emission. Allow that writer to exit; never sample twice.
    for attempt in range(91):
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            if attempt == 90:
                raise
            time.sleep(1)


def load_previous(state):
    try:
        fd = private_open(state / 'latest.json', os.O_RDONLY)
    except FileNotFoundError:
        return None
    with os.fdopen(fd) as stream:
        raw = stream.read(16385)
    if len(raw) > 16384:
        raise ValueError('previous_sample_too_large')
    previous = json.loads(raw)
    if previous.get('schema_version') != 1:
        raise ValueError('previous_schema_unknown')
    return previous


def statsd_lines(sample):
    lines = []
    for name, _, unit, family, dimensions in CHARTS:
        for dim, group, field in dimensions:
            value = sample[group].get(field)
            if value is not None:
                lines.append('home_memory.%s.%s:%s|g|#units=%s,family=%s,name=%s' % (name, dim, value, unit, family, dim))
    lines.append('home_memory.collector_quality.complete:%s|g|#units=complete,family=collector,name=complete' % int(sample['quality'] == 'ok'))
    return lines


def statsd_once(state, interval):
    private_directory(state)
    with os.fdopen(private_open(state / 'collector.lock', os.O_WRONLY | os.O_CREAT | os.O_APPEND), 'a') as lock:
        # Existing schedule may overlap; never wait or launch a second sampler.
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        previous = load_previous(state)
        if (previous and previous.get('monotonic_clock') == MONOTONIC_CLOCK
                and 0 <= steady_seconds() - previous['monotonic_seconds'] < interval):
            return
        sample = collect(previous)
        # UDP cannot acknowledge persistence; verify chart delivery separately.
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.settimeout(1)
            for line in statsd_lines(sample):
                sock.sendto((line + '\n').encode(), ('127.0.0.1', 8125))
        save(sample, state)


CHARTS = [
    ('host_memory', 'macOS memory gauges (overlapping categories)', 'MiB', 'memory',
     [('active', 'host', 'active_mib'), ('inactive', 'host', 'inactive_mib'),
      ('wired', 'host', 'wired_mib'), ('compressor', 'host', 'compressor_mib'),
      ('free', 'host', 'free_mib'), ('purgeable', 'host', 'purgeable_mib')]),
    ('compressor', 'macOS compressor physical and logical size', 'MiB', 'memory',
     [('physical', 'host', 'compressor_mib'), ('logical', 'host', 'compressed_logical_mib')]),
    ('swap', 'macOS swap occupied', 'MiB', 'swap', [('used', 'host', 'swap_used_mib')]),
    ('swap_io', 'macOS swap I/O interval average', 'MiB/s', 'swap',
     [('in', 'host', 'swap_in_mib_s'), ('out', 'host', 'swap_out_mib_s')]),
    ('paging', 'macOS paging interval average', 'MiB/s', 'memory',
     [('in', 'host', 'page_in_mib_s'), ('out', 'host', 'page_out_mib_s')]),
    ('faults', 'macOS translation faults', 'faults/s', 'memory', [('faults', 'host', 'page_faults_s')]),
    ('pressure', 'macOS memory pressure (1 normal, 2 warning, 4 critical)', 'level', 'memory',
     [('level', 'host', 'pressure_level')]),
    ('codex_footprint', 'Codex direct app process footprint', 'MiB', 'codex',
     [('footprint', 'codex', 'footprint_mib')]),
    ('codex_processes', 'Codex direct app process count', 'processes', 'codex',
     [('count', 'codex', 'process_count'), ('matched', 'codex', 'matched_process_count')]),
    ('codex_uptime', 'Codex main process uptime', 'seconds', 'codex', [('uptime', 'codex', 'uptime_seconds')]),
    ('collector_cost', 'Memory collector elapsed and CPU time per sample', 'seconds', 'collector',
     [('elapsed', 'collector', 'duration_seconds'), ('cpu', 'collector', 'cpu_seconds')]),
]


def define_charts(interval):
    for i, (name, title, unit, family, dimensions) in enumerate(CHARTS):
        print("CHART home_memory.%s '' '%s' '%s' '%s' 'home_memory.%s' line %s %s '' 'home-memory' 'native'"
              % (name, title, unit, family, name, 95000 + i, interval))
        for dim, _, _ in dimensions:
            print("DIMENSION %s '' absolute 1 1000" % dim)
    print("CHART home_memory.collector_quality '' 'Memory sample completeness' 'complete' 'collector' 'home_memory.collector_quality' line 95020 %s '' 'home-memory' 'native'" % interval)
    print("DIMENSION complete '' absolute 1 1")
    sys.stdout.flush()


def emit(sample):
    for name, _, _, _, dimensions in CHARTS:
        print('BEGIN home_memory.' + name)
        for dim, group, field in dimensions:
            value = sample[group].get(field)
            # Unavailable data is omitted, never reported as a false zero.
            if value is not None:
                print('SET %s = %s' % (dim, round(value * 1000)))
        print('END')
    print('BEGIN home_memory.collector_quality\nSET complete = %s\nEND' % int(sample['quality'] == 'ok'), flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('interval', nargs='?', type=int, default=60)
    parser.add_argument('--state-dir', type=Path, default=STATE)
    parser.add_argument('--once', action='store_true', help='one read-only sample, no protocol or files')
    parser.add_argument('--statsd-once', action='store_true', help='one due sample to existing localhost StatsD plus private history')
    args = parser.parse_args()
    if args.interval < 60 or args.interval > 120:
        parser.error('interval must be 60..120 seconds')
    os.umask(0o077)
    if args.once:
        print(json.dumps(collect(), indent=2, allow_nan=False))
        return
    if args.statsd_once:
        statsd_once(args.state_dir, args.interval)
        return
    private_directory(args.state_dir)
    with os.fdopen(private_open(args.state_dir / 'collector.lock', os.O_WRONLY | os.O_CREAT | os.O_APPEND), 'a') as lock:
        acquire_lock(lock)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        define_charts(args.interval)
        previous = None
        while True:
            sample = collect(previous)
            try:
                save(sample, args.state_dir)
            except Exception as exc:
                sample['errors'].append('persist_' + type(exc).__name__)
                sample['quality'] = 'partial'
                print('home-memory: persistence failed: ' + type(exc).__name__, file=sys.stderr, flush=True)
            emit(sample)
            previous = sample
            time.sleep(max(1, args.interval - (steady_seconds() - sample['monotonic_seconds'])))


if __name__ == '__main__':
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
